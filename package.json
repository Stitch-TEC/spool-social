{
  "name": "spool-social",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:action-pins": "node scripts/check-action-pins.mjs",
    "test:rules": "npx --yes firebase-tools@15.22.3 emulators:exec --only firestore \"vitest run firestore.rules.test.js\"",
    "test:watch": "vitest",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "DEPLOY_TARGET=pages npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.7.0",
    "html2canvas-pro": "^1.6.7",
    "lucide-react": "^0.562.0",
    "micromark": "^4.0.2",
    "micromark-util-decode-string": "^2.0.1",
    "parse5": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "vitest": "^4.1.7",
    "wrangler": "~4.116.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "undici": "^7.29.0"
  }
}
